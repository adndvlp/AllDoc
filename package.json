{
  "name": "alldoc",
  "version": "0.1.0",
  "private": true,
  "description": "Apuntes personales para recordar conceptos de un vistazo.",
  "scripts": {
    "start": "node --experimental-strip-types scripts/serve-with-runtime.mjs dev",
    "build": "docusaurus build",
    "serve": "node --experimental-strip-types scripts/serve-with-runtime.mjs serve",
    "build:runtime": "node --experimental-strip-types scripts/build-practice-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:practice-data": "node --experimental-strip-types scripts/verify-practice-data.mjs",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "test:ui:report": "playwright show-report",
    "test:ui:practice": "playwright test tests/ui/practice.spec.ts",
    "test:ui:sql": "playwright test tests/ui/sqlite.spec.ts",
    "test:ui:overlay": "playwright install chromium && playwright test tests/ui/search.spec.ts --project=celular -g 'atajo desde'",
    "baseline": "node scripts/capture-baseline.mjs",
    "verify:final": "node scripts/verify-final.mjs",
    "build:ui": "PRACTICE_ORIGIN=http://localhost:4174 DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-ui docusaurus build --out-dir .ui-build",
    "serve:ui": "node --experimental-strip-types scripts/serve-with-runtime.mjs ui",
    "update:stack": "node scripts/update-stack.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "latest",
    "@codemirror/commands": "latest",
    "@codemirror/lang-python": "latest",
    "@codemirror/lang-sql": "latest",
    "@codemirror/language": "latest",
    "@codemirror/state": "latest",
    "@codemirror/view": "latest",
    "@docusaurus/core": "latest",
    "@docusaurus/preset-classic": "latest",
    "@mdx-js/react": "latest",
    "@lezer/highlight": "latest",
    "@sqlite.org/sqlite-wasm": "latest",
    "prism-react-renderer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@docusaurus/module-type-aliases": "latest",
    "@docusaurus/types": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "webpack": "latest"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
