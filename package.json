{
  "name": "alldoc",
  "version": "0.1.0",
  "private": true,
  "description": "Apuntes personales para recordar conceptos de un vistazo.",
  "scripts": {
    "start": "node --experimental-strip-types scripts/serve-with-runtime.mjs dev",
    "build": "docusaurus build",
    "serve": "node --experimental-strip-types scripts/serve-with-runtime.mjs serve",
    "build:runtime": "node --experimental-strip-types scripts/build-practice-runtime.mjs",
    "prepare:python": "node --experimental-strip-types scripts/prepare-python-runtime.mjs",
    "update:python": "node --experimental-strip-types scripts/prepare-python-runtime.mjs --update",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:practice-data": "node --experimental-strip-types scripts/verify-practice-data.mjs",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "test:ui:report": "playwright show-report",
    "test:browser:preflight": "node --experimental-strip-types scripts/browser-preflight.mjs",
    "test:browser:smoke": "node --experimental-strip-types scripts/test-browser.mjs --smoke",
    "test:browser": "node --experimental-strip-types scripts/test-browser.mjs",
    "test:browser:update": "node --experimental-strip-types scripts/test-browser.mjs --visual --update-snapshots",
    "verify:browser": "node --experimental-strip-types scripts/verify-browser.mjs",
    "test:ui:practice": "playwright test tests/ui/practice.spec.ts",
    "test:ui:sql": "playwright test tests/ui/sqlite.spec.ts",
    "test:ui:business": "playwright test tests/ui/sql-business.spec.ts --project=celular --project=laptop",
    "test:ui:sql:docs": "playwright test tests/ui/sql-dialects.spec.ts --project=celular --project=laptop",
    "test:ui:sql:third": "playwright test tests/ui/sql-third-block.spec.ts --project=celular --project=laptop",
    "test:ui:sql:reading": "playwright test tests/ui/notes.spec.ts --project=celular --workers=1 -g 'texto al 200|anterior y siguiente'",
    "test:ui:sql:search": "playwright test tests/ui/search.spec.ts --project=celular --project=laptop --workers=1",
    "test:ui:sql:second": "playwright test tests/ui/sql-second-block.spec.ts --project=celular --project=laptop",
    "test:ui:sql:compact": "playwright test tests/ui/notes.spec.ts --project=celular -g 'recuerdo sin tapar'",
    "test:ui:sql:editorial": "playwright test tests/ui/sql-third-block.spec.ts tests/ui/search.spec.ts tests/ui/sql-second-block.spec.ts tests/ui/sql-dialects.spec.ts tests/ui/notes.spec.ts tests/ui/responsive.spec.ts tests/ui/catalog.spec.ts tests/ui/practice-actions.spec.ts tests/ui/sql-business.spec.ts tests/ui/sqlite.spec.ts tests/ui/pandas.spec.ts --project=celular --project=laptop",
    "test:ui:sql:regression": "playwright test tests/ui/sql-business.spec.ts tests/ui/sqlite.spec.ts tests/ui/practice.spec.ts tests/ui/practice-actions.spec.ts tests/ui/practice-storage.spec.ts --project=celular --project=laptop",
    "test:ui:actions": "playwright test tests/ui/practice-actions.spec.ts",
    "test:ui:actions:smoke": "playwright test tests/ui/practice-actions.spec.ts --project=celular -g 'ejemplo explícito'",
    "test:ui:python": "playwright test tests/ui/python.spec.ts",
    "test:ui:python:smoke": "playwright test tests/ui/python.spec.ts --project=celular -g 'DataFrame real'",
    "test:ui:python:check": "playwright test tests/ui/python.spec.ts --project=celular --project=laptop --update-snapshots",
    "test:ui:overlay": "playwright install chromium && playwright test tests/ui/search.spec.ts --project=celular -g 'atajo desde'",
    "baseline": "node scripts/capture-baseline.mjs",
    "verify:final": "node scripts/verify-final.mjs",
    "verify:practice": "node --experimental-strip-types scripts/verify-practice.mjs",
    "build:ui": "PRACTICE_ORIGIN=http://localhost:4174 DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-ui docusaurus build --out-dir .ui-build",
    "serve:ui": "node --experimental-strip-types scripts/serve-with-runtime.mjs ui",
    "update:stack": "node scripts/update-stack.mjs",
    "test:ui:sql:navigation": "playwright test tests/ui/sql-navigation.spec.ts --project=celular --project=laptop --workers=1",
    "test:ui:sql:structure": "playwright test tests/ui/sql-navigation.spec.ts tests/ui/catalog.spec.ts tests/ui/responsive.spec.ts tests/ui/header.spec.ts tests/ui/personal-library.spec.ts tests/ui/search.spec.ts tests/ui/notes.spec.ts tests/ui/sql-dialects.spec.ts tests/ui/practice.spec.ts tests/ui/sqlite.spec.ts tests/ui/pandas.spec.ts --project=celular --project=laptop --workers=1 --max-failures=0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "latest",
    "@codemirror/commands": "latest",
    "@codemirror/lang-python": "latest",
    "@codemirror/lang-sql": "latest",
    "@codemirror/language": "latest",
    "@codemirror/state": "latest",
    "@codemirror/view": "latest",
    "@docusaurus/core": "latest",
    "@docusaurus/preset-classic": "latest",
    "@mdx-js/react": "latest",
    "@lezer/highlight": "latest",
    "@sqlite.org/sqlite-wasm": "latest",
    "pyodide": "latest",
    "prism-react-renderer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@docusaurus/module-type-aliases": "latest",
    "@docusaurus/types": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "webpack": "latest"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
