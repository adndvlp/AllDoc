# Estas variables se exportan en la terminal/CI antes de compilar; no se carga .env automáticamente.
# Desarrollo local: npm start inicia app 127.0.0.1:3000 + runtime localhost:3001.
# Publicación: orígenes HTTPS distintos y dominio de runtime dedicado, sin cookies de la app.
SITE_URL=https://alldoc.example
PRACTICE_APP_ORIGIN=https://alldoc.example
PRACTICE_ORIGIN=https://alldoc-runtime.example
